NODE_ENV=development
VITE_API_BASE_URL=http://localhost:4000/api/v1
PORT=4000
DATABASE_URL=postgresql://forest_side:replace_me@localhost:5432/forest_side?schema=public
APP_ORIGINS=http://localhost:5173
SESSION_TTL_HOURS=12
WEATHER_LOCATION_NAME=Guptkashi
WEATHER_CACHE_TTL_SECONDS=900
# Optional SMTP. Email delivery is disabled until all SMTP values are supplied.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
OWNER_NOTIFICATION_EMAIL=
# Optional WhatsApp Business Cloud API. No messages are sent without guest consent.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v22.0
WHATSAPP_TEMPLATE_BOOKING_ACK=
WHATSAPP_TEMPLATE_BOOKING_STATUS=
WHATSAPP_TEMPLATE_PREARRIVAL=
# Optional first administrator bootstrap. Supply temporarily in the environment, never commit credentials.
ADMIN_EMAIL=
ADMIN_PASSWORD=
